  "item": [
    {
      "name": "Success cases",
      "item": [
        {
          "name": "01 GET all books (defaults)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response content is correct', function () { pm.expect(pm.response.json()).to.be.an('array').with.length.at.most(10); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            }
          }
        },
        {
          "name": "02 GET one book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response content is correct', function () { pm.expect(pm.response.json().id).to.eql(3); });"
                ]
              }
